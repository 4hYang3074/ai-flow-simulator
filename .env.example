# Copy to .env (npm run setup does this for you) and change values if needed.

# Where Ollama is listening. The default is Ollama's own default.
OLLAMA_HOST=http://127.0.0.1:11434

# The two local models this project uses.
CHAT_MODEL=qwen3:4b-instruct
EMBED_MODEL=qwen3-embedding:0.6b

# Ports for npm run dev. Change them if something else already uses one.
BACKEND_PORT=8787
FRONTEND_PORT=5173

# Where conversations and memory are stored, relative to the project folder.
DB_PATH=data/flow-sim.db

# Set to 1 to restart the backend automatically when its code changes
# (only useful while editing the backend).
BACKEND_RELOAD=0
